digraph architecture {
    // Global Diagram Settings
    graph [
        bgcolor="#F8FAFC",
        fontname="system-ui, -apple-system, sans-serif",
        nodesep=0.8,
        ranksep=0.8,
        splines=ortho,
        rankdir=TB,
        pad="0.5"
    ];

    // Global Title
    labelloc="t";
    label=<
        <table border="0" cellborder="0" cellpadding="0">
            <tr><td align="center"><font point-size="28" color="#111827"><b>AI_Powered Sustainable Manufacturing Optimization</b></font></td></tr>
            <tr><td align="center"><font point-size="16" color="#4B5563">From raw industrial data to forecasts, anomaly monitoring, optimization, API, and public dashboard</font></td></tr>
            <tr><td> </td></tr>
        </table>
    >;

    // Global Node and Edge Settings
    node [
        fontname="system-ui, -apple-system, sans-serif",
        shape=box,
        style="filled,rounded",
        penwidth=2,
        margin="0.3,0.2"
    ];
    edge [
        color="#9CA3AF",
        penwidth=2.5,
        arrowhead="vee"
    ];

    // ==========================================
    // MAIN FLOWCHART PIPELINE
    // ==========================================
    subgraph cluster_pipeline {
        border=0;
        style=invis; // Keeps it grouped without a visible border

        // 1. Data Sources (Blue)
        node [fillcolor="#EFF6FF", color="#93C5FD"];
        TEC [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>🛢️ TEC_48S.zip</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Machine sensor readings</font></td></tr></table>>];
        IPE [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>☀️ IPE_PV.zip</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Solar PV readings</font></td></tr></table>>];
        DWD [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>🌧️ DWD + SMARD</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Weather + market prices</font></td></tr></table>>];

        // 2. ETL (Green)
        node [fillcolor="#F0FDF4", color="#86EFAC"];
        ETL [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>⚙️ etl_pipeline.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Ingest, align, validate, aggregate</font></td></tr></table>>];
        
        // 3. Processed Data (Green)
        PROCESSED [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>📂 data/processed/</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Cleaned tables, features, manifest</font></td></tr></table>>];

        // 4. EDA (Orange) & Training Pipeline (Purple)
        node [fillcolor="#FFFBEB", color="#FDE047"];
        EDA [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>📊 notebooks/EDA/</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">3 notebooks: machine, solar, prices</font></td></tr></table>>];
        
        node [fillcolor="#FAF5FF", color="#D8B4FE"];
        TRAINING_BASE [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>🧪 training_pipeline.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Time-safe experiments + MLFlow</font></td></tr></table>>];

        // 5. Training Modules (Purple)
        FORECAST [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>📈 train_forecasting.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">15-min forecasting</font></td></tr></table>>];
        ANOMALY [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>⚠️ train_anomaly.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Advisory anomaly monitoring</font></td></tr></table>>];
        SCHEDULER [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>🗓️ scheduler.py + constraints.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">MILP job scheduling</font></td></tr></table>>];

        // 6. Reports Output (Green)
        node [fillcolor="#F0FDF4", color="#86EFAC"];
        REPORTS [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>📄 reports/ml_short_term/application_runs/</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Forecast, anomaly, and optimization reports</font></td></tr></table>>];

        // 7. Apps & Deployments (Teal)
        node [fillcolor="#ECFEFF", color="#67E8F9"];
        STREAMLIT [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>💻 app/streamlit_app.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Public dashboard</font></td></tr></table>>];
        FASTAPI [label=<<table border="0" cellborder="0" cellpadding="2"><tr><td align="center"><font point-size="14" color="#111827"><b>🔌 app/main.py</b></font></td></tr><tr><td align="center"><font point-size="12" color="#4B5563">Local FastAPI reports + inference</font></td></tr></table>>];

        // Alignments (Forces nodes to be on the same horizontal level)
        { rank=same; TEC; IPE; DWD; }
        { rank=same; EDA; TRAINING_BASE; }
        { rank=same; FORECAST; ANOMALY; SCHEDULER; }
        { rank=same; STREAMLIT; FASTAPI; }

        // Connecting Edges
        TEC -> ETL;
        IPE -> ETL;
        DWD -> ETL;
        ETL -> PROCESSED;
        PROCESSED -> EDA;
        PROCESSED -> TRAINING_BASE;
        TRAINING_BASE -> FORECAST;
        TRAINING_BASE -> ANOMALY;
        TRAINING_BASE -> SCHEDULER;
        FORECAST -> REPORTS;
        ANOMALY -> REPORTS;
        SCHEDULER -> REPORTS;
        REPORTS -> STREAMLIT;
        REPORTS -> FASTAPI;
    }

    // ==========================================
    // SIDEBAR LEGEND
    // ==========================================
    subgraph cluster_legend {
        label=<<b>Pipeline Stages</b>>;
        fontsize=18;
        color="#E5E7EB";
        penwidth=2;
        bgcolor="#FFFFFF";
        style="rounded";
        margin=20;

        node [shape=box, style="filled,rounded", penwidth=2, width=3.5, margin="0.3,0.2"];
        
        LEGEND_1 [fillcolor="#EFF6FF", color="#93C5FD", label=<<table border="0" cellborder="0" cellpadding="1"><tr><td align="left"><font point-size="14" color="#111827"><b>🛢️ Data Sources</b></font></td></tr><tr><td align="left"><font point-size="12" color="#4B5563">Raw industrial, solar, weather,<br/>and market data</font></td></tr></table>>];
        LEGEND_2 [fillcolor="#F0FDF4", color="#86EFAC", label=<<table border="0" cellborder="0" cellpadding="1"><tr><td align="left"><font point-size="14" color="#111827"><b>⚙️ ETL / Data Processing</b></font></td></tr><tr><td align="left"><font point-size="12" color="#4B5563">Ingest, align, validate, and prepare</font></td></tr></table>>];
        LEGEND_3 [fillcolor="#FFFBEB", color="#FDE047", label=<<table border="0" cellborder="0" cellpadding="1"><tr><td align="left"><font point-size="14" color="#111827"><b>📊 Exploration (EDA)</b></font></td></tr><tr><td align="left"><font point-size="12" color="#4B5563">Understand data and scenarios</font></td></tr></table>>];
        LEGEND_4 [fillcolor="#FAF5FF", color="#D8B4FE", label=<<table border="0" cellborder="0" cellpadding="1"><tr><td align="left"><font point-size="14" color="#111827"><b>🧪 Training / Modeling</b></font></td></tr><tr><td align="left"><font point-size="12" color="#4B5563">Experiments and model training<br/>(forecasting, anomaly, optimization)</font></td></tr></table>>];
        LEGEND_5 [fillcolor="#F0FDF4", color="#86EFAC", label=<<table border="0" cellborder="0" cellpadding="1"><tr><td align="left"><font point-size="14" color="#111827"><b>📄 Outputs / Reports</b></font></td></tr><tr><td align="left"><font point-size="12" color="#4B5563">Forecast, anomaly, and<br/>optimization reports</font></td></tr></table>>];
        LEGEND_6 [fillcolor="#ECFEFF", color="#67E8F9", label=<<table border="0" cellborder="0" cellpadding="1"><tr><td align="left"><font point-size="14" color="#111827"><b>💻 Deployment / Apps</b></font></td></tr><tr><td align="left"><font point-size="12" color="#4B5563">Public dashboard and local API</font></td></tr></table>>];

        // Invisible connections to keep the legend neatly stacked
        edge [style=invis];
        LEGEND_1 -> LEGEND_2 -> LEGEND_3 -> LEGEND_4 -> LEGEND_5 -> LEGEND_6;
    }

    // Invisible positioning hack to ensure the legend sits on the right side of the main flow
    DWD -> LEGEND_1 [style=invis, minlen=1.5];
}